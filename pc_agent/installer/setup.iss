; SlateSync - Inno Setup installer script (Doc 19, Wave 3.A authoring only)
; Compile in Wave 3.B only: ISCC.exe pc_agent\installer\setup.iss
; Requires the Wave 3.A PyInstaller bundle at ..\..\dist\SlateSyncAgent\ (Doc 18).
; ASCII-only content - no non-ASCII bytes, safe with or without a UTF-8 BOM.

#define MyAppName "SlateSync"
#define MyAppVersion "1.0.0"
#define MyAppExeName "SlateSyncAgent.exe"
#define WsPort "50606"
#define FirewallRule "SlateSync WS"

[Setup]
; Fixed AppId GUID - upgrades replace in place; never change across releases (Doc 19 Section 4).
AppId={{8F3C2A1B-5D4E-4B9C-A7F6-1E2D3C4B5A69}
; Issue 05 UPGRADE/REPAIR: running this setup over an old install updates IN
; PLACE - Inno's default behavior with an unchanged AppId (the previous
; version is NOT uninstalled first; files are replaced, settings kept).
; UsePrevious* reuses the prior install's directory/group choices.
UsePreviousAppDir=yes
UsePreviousGroup=yes
UsePreviousTasks=yes
AppName={#MyAppName}
AppVersion={#MyAppVersion}
VersionInfoVersion={#MyAppVersion}
DefaultDirName={autopf}\SlateSync
DefaultGroupName={#MyAppName}
UninstallDisplayName={#MyAppName}
; Template Section 3 constant: installer output dist\SlateSync_Setup.exe.
; OutputDir is relative to this .iss (pc_agent\installer\..\..\dist = repo dist\).
OutputDir=..\..\dist
OutputBaseFilename=SlateSync_Setup
PrivilegesRequired=admin
Compression=lzma2
SolidCompression=yes
; Issue 05: installer icon - pc_agent/assets/slatesync.ico (generated by
; pc_agent/assets/gen_branding.py); path is relative to this .iss file.
SetupIconFile=..\assets\slatesync.ico

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\..\dist\SlateSyncAgent\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\SlateSync"; Filename: "{app}\SlateSyncAgent.exe"
Name: "{autodesktop}\SlateSync"; Filename: "{app}\SlateSyncAgent.exe"

[Registry]
Root: HKCR; Subkey: ".slatesync"; ValueType: string; ValueData: "SlateSyncCanvas"; Flags: uninsdeletekey
Root: HKCR; Subkey: "SlateSyncCanvas"; ValueType: string; ValueData: "SlateSync Canvas"; Flags: uninsdeletekey
Root: HKCR; Subkey: "SlateSyncCanvas\DefaultIcon"; ValueType: string; ValueData: "{app}\SlateSyncAgent.exe,0"
Root: HKCR; Subkey: "SlateSyncCanvas\shell\open\command"; ValueType: string; ValueData: """{app}\SlateSyncAgent.exe"" ""%1"""

[Run]
; Issue 05: idempotent firewall rule - repair/upgrade re-runs detect the
; existing rule first (show ... >nul || add) so duplicates are never stacked.
; "" doubling is Inno 6.4 escaping of cmd's quotes (same style as before).
Filename: "{cmd}"; Parameters: "/C netsh advfirewall firewall show rule name=""SlateSync WS"" >nul 2>&1 || netsh advfirewall firewall add rule name=""SlateSync WS"" dir=in action=allow protocol=TCP localport=50606"; Flags: runhidden waituntilterminated
Filename: "{app}\SlateSyncAgent.exe"; Description: "Launch SlateSync"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{cmd}"; Parameters: "/C netsh advfirewall firewall delete rule name=""SlateSync WS"""; Flags: runhidden waituntilterminated; RunOnceId: "RemoveFirewallRule"

[UninstallDelete]
Type: filesandordirs; Name: "{app}\logs"
Type: files; Name: "{app}\*.log"

[Code]
{ Issue 05: Fresh / UPGRADE / REPAIR detection for the welcome-page banner.
  Prior state is read from the Inno uninstall entry of the fixed AppId
  (DisplayVersion = previous release).  Same version => REPAIR mode,
  different version => UPGRADE mode, no entry => Fresh install. }
var
  HasPriorInstall: Boolean;
  PriorVersion: String;

function InitializeSetup(): Boolean;
var
  UninstallKey: String;
begin
  UninstallKey := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{8F3C2A1B-5D4E-4B9C-A7F6-1E2D3C4B5A69}_is1';
  HasPriorInstall := RegKeyExists(HKLM, UninstallKey);
  PriorVersion := '';
  if HasPriorInstall then
    RegQueryStringValue(HKLM, UninstallKey, 'DisplayVersion', PriorVersion);
  if HasPriorInstall and (PriorVersion = '') then
    PriorVersion := 'unknown';
  Result := True;  // never block the wizard; the banner only reports state
end;

procedure InitializeWizard();
var
  Banner: TNewStaticText;
  AnchorBottom: Integer;
begin
  { Prepend the install-mode status banner to the welcome page (right column,
    below the standard welcome paragraph - clear of the image and buttons). }
  Banner := TNewStaticText.Create(WizardForm.WelcomePage);
  Banner.Parent := WizardForm.WelcomePage;
  if not HasPriorInstall then
    Banner.Caption := 'Fresh install'
  else if SameText(PriorVersion, '{#MyAppVersion}') then
    Banner.Caption := 'REPAIR: v' + PriorVersion + ' already installed - files will be re-written, settings kept'
  else
    Banner.Caption := 'UPGRADE: v' + PriorVersion + ' -> v{#MyAppVersion} (your data & settings are preserved)';
  Banner.ShowAccelChar := False;  // render the '&' literally in the caption
  Banner.AutoSize := False;
  Banner.WordWrap := True;
  Banner.Left := WizardForm.WelcomeLabel2.Left;
  Banner.Width := WizardForm.WelcomeLabel2.Width;
  AnchorBottom := WizardForm.WelcomeLabel2.Top + WizardForm.WelcomeLabel2.Height;
  if AnchorBottom < ScaleY(150) then  // defensive: page not sized yet
    AnchorBottom := WizardForm.ClientHeight;
  Banner.Top := AnchorBottom - ScaleY(78);
  Banner.AdjustHeight;
end;

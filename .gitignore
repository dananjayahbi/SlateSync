# Python virtualenvs & tool caches
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
build/
dist/

# Flutter / Dart
.dart_tool/
.flutter-plugins*

# Logs & user documents (*.slatesync = ZIP containers, user data, never committed)
*.log
*.slatesync

# %APPDATA%/SlateSync runtime artifacts (if a dev/test redirect lands them in-repo)
AppData/
appdata/

# NOTE: pc_agent/installer/slatesync_agent.spec (PyInstaller) stays TRACKED — do not add *.spec here.

# Flutter widget-test scratch dirs (each suite isolates its own appdata/db root)
mobile_app/test/.*_tmp/
